{
  "rules": {
    ".read": false,
    ".write": false,
    "match_votes": {
      ".read": "auth != null",
      "$matchId": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.val() === 'home' || newData.val() === 'draw' || newData.val() === 'away'"
        }
      }
    }
  }
}
